    "guidelines_zero_tolerance" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have zero tolerance for objectionable content and abusive users. Reported content is reviewed within 24 hours; content that breaks these rules is removed and the account responsible may be suspended."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygunsuz içeriğe ve kötü niyetli kullanıcılara sıfır tolerans gösteriyoruz. Şikayet edilen içerikler 24 saat içinde incelenir; kurallara aykırı içerik kaldırılır ve sorumlu hesap askıya alınabilir."
          }
        }
      }
    },
