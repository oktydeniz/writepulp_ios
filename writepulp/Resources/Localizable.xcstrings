    "ob_desc_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore thousands of curated books and articles written by talented authors from around the world. Dive into new worlds today."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dünyanın dört bir yanından yetenekli yazarların binlerce kitap ve makalesini keşfet. Yeni dünyalara bugün dal."
          }
        }
      }
    },
    "ob_desc_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access your entire library on any device. Your progress stays in sync whether you are on your phone, tablet, or desktop."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kütüphanenin tamamına her cihazdan eriş. İster telefonda, ister tablette ya da bilgisayarda ol, ilerlemen her zaman senkronize kalır."
          }
        }
      }
    },
    "ob_desc_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your ideas into professional stories. Use our powerful editor to reach millions of readers and build your own audience."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikirlerini profesyonel hikayelere dönüştür. Güçlü editörümüzle milyonlarca okuyucuya ulaş ve kendi kitlenizi oluştur."
          }
        }
      }
    },
    "ob_desc_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect with fellow writers and readers. Share feedback, collaborate on projects, and grow together in our creative ecosystem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer yazar ve okuyucularla bağlantı kur. Geri bildirim paylaş, projelerde iş birliği yap ve yaratıcı ekosistemimizde birlikte büyü."
          }
        }
      }
    },
    "ob_desc_5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join WritePulp today - read, write, and earn as you turn every page."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WritePulp'a bugün katıl - her sayfayı çevirirken oku, yaz ve kazan."
          }
        }
      }
    },
